{
  "manifest_version": "0.3",
  "name": "droptocdn",
  "display_name": "Drop to CDN",
  "version": "0.1.3",
  "description": "Upload files and get instant public CDN URLs from Claude Desktop, Cursor, and other MCP hosts.",
  "long_description": "Drop to CDN MCP server — upload local files or base64 content and receive public CDN URLs. List, inspect, and delete files in your account.",
  "author": {
    "name": "Drop to CDN",
    "email": "support@droptocdn.com",
    "url": "https://droptocdn.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexus-JPF/mcp-server-droptocdn.git"
  },
  "homepage": "https://droptocdn.com/integrations/mcp",
  "documentation": "https://droptocdn.com/integrations/mcp",
  "support": "https://github.com/Nexus-JPF/mcp-server-droptocdn/issues",
  "icon": "icon.png",
  "keywords": ["mcp", "cdn", "file-upload", "droptocdn", "upload"],
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "npx",
      "args": ["-y", "mcp-server-droptocdn@0.1.3"],
      "env": {
        "DROPTOCDN_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "Drop to CDN API Key",
      "description": "Your API key (dtc_...). Create one at https://droptocdn.com/dashboard/settings",
      "sensitive": true,
      "required": true
    }
  }
}
