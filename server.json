{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Nexus-JPF/droptocdn",
  "title": "Drop to CDN",
  "description": "Upload files and get instant public CDN URLs from Claude Desktop, Cursor, and other MCP hosts.",
  "websiteUrl": "https://droptocdn.com/integrations/mcp",
  "repository": {
    "url": "https://github.com/Nexus-JPF/mcp-server-droptocdn",
    "source": "github"
  },
  "version": "0.1.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mcp-server-droptocdn",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DROPTOCDN_API_KEY",
          "description": "Drop to CDN API key (dtc_...). Create one at https://droptocdn.com/dashboard/settings",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "DROPTOCDN_API_URL",
          "description": "API base URL (default https://api.droptocdn.com/v1)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
